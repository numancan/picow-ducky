#include "input.h"

#include "FreeRTOS.h"
#include "debug.h"
#include "hal/hal.h"
#include "hal/hal_gpio.h"
#include "stdio.h"
#include "stdlib.h"
#include "task.h"
#include "timers.h"

#define DEBOUNCE_MS (30)
#define LONG_PRESS_MS (800)
#define TIMER_PERIOD_MS (10)
#define DOUBLE_PRESS_WINDOW_MS (150)

typedef enum {
    INPUT_PIN_STATE_IDLE,
    INPUT_PIN_STATE_PRESSED,
    INPUT_PIN_STATE_WAIT_DOUBLE,  // İlk basış bırakıldı, ikinci bekleniyor
} InputPinState;

typedef struct {
    GpioInput* gpio;
    TimerHandle_t timer_handler;
    volatile uint16_t press_count_ms;  // Tuş basılı tutulma süresi
    volatile uint16_t wait_count_ms;   // Double press bekleme süresi
    volatile InputPinState pin_state;
} InputState;

typedef struct {
    InputState* states;
    PubSubFree* pubsub;
} Input;

static Input* input = NULL;

/*
 * Tek timer callback: hangi state'deyiz → doğru sayacı artır.
 * WAIT_DOUBLE timeout'u ana döngü kontrol eder.
 */
static void input_timer_callback(TimerHandle_t xTimer) {
    uint8_t timer_id = (uint8_t)pvTimerGetTimerID(xTimer);
    InputState* state = &input->states[timer_id];

    if (state->pin_state == INPUT_PIN_STATE_PRESSED) {
        state->press_count_ms += TIMER_PERIOD_MS;
    } else if (state->pin_state == INPUT_PIN_STATE_WAIT_DOUBLE) {
        state->wait_count_ms += TIMER_PERIOD_MS;
    }
}

const char* input_event_get_name(InputEventType event_type) {
    switch (event_type) {
        case INPUT_EVENT_TYPE_PRESS:
            return "Press";
        case INPUT_EVENT_TYPE_DOUBLE_PRESS:
            return "Double Press";
        case INPUT_EVENT_TYPE_LONG_PRESS:
            return "Long Press";
        case INPUT_EVENT_TYPE_RELEASE:
            return "Release";
        default:
            return "wtf?";
    }
}

static void input_publish(InputState* state, InputEventType type) {
    InputEvent event = {.type = type, .key = state->gpio->key};
    pubsub_free_notify(input->pubsub, &event);
    DEBUG_PRINTF("Button Key: %d - Event: %s - Press(ms): %d\n", state->gpio->key,
                 input_event_get_name(type), state->press_count_ms);
}

PubSubFree* input_get_pubsub() { return input->pubsub; }

void input_init() {
    input = (Input*)malloc(sizeof(Input));
    input->states = (InputState*)malloc(sizeof(InputState) * gpio_input_count);
    input->pubsub = pubsub_alloc();
}

void input_service() {
    for (size_t i = 0; i < gpio_input_count; i++) {
        input->states[i].gpio = (GpioInput*)&gpio_inputs[i];
        input->states[i].press_count_ms = 0;
        input->states[i].wait_count_ms = 0;
        input->states[i].pin_state = INPUT_PIN_STATE_IDLE;
        input->states[i].timer_handler =
            xTimerCreate("TM_IN", pdMS_TO_TICKS(TIMER_PERIOD_MS), pdTRUE, (void*)i,
                         input_timer_callback);
    }

    while (true) {
        for (size_t i = 0; i < gpio_input_count; i++) {
            InputState* s = &input->states[i];
            uint8_t pin_val = hal_gpio_read(s->gpio->pin);
            bool pressed = (pin_val != s->gpio->default_state);

            switch (s->pin_state) {
                case INPUT_PIN_STATE_IDLE:
                    if (pressed) {
                        s->press_count_ms = 0;
                        s->pin_state = INPUT_PIN_STATE_PRESSED;
                        xTimerStart(s->timer_handler, 0);
                    }
                    break;

                case INPUT_PIN_STATE_PRESSED:
                    if (!pressed) {
                        xTimerStop(s->timer_handler, 0);

                        if (s->press_count_ms >= LONG_PRESS_MS) {
                            /* Long press: double press bekleme yok, direkt yayınla */
                            input_publish(s, INPUT_EVENT_TYPE_LONG_PRESS);
                            s->pin_state = INPUT_PIN_STATE_IDLE;

                        } else if (s->press_count_ms >= DEBOUNCE_MS) {
                            /* Geçerli kısa basış: double press penceresi aç */
                            s->wait_count_ms = 0;
                            s->pin_state = INPUT_PIN_STATE_WAIT_DOUBLE;
                            xTimerStart(s->timer_handler, 0);  // wait sayacı için devam

                        } else {
                            /* Debounce altı: yoksay */
                            s->pin_state = INPUT_PIN_STATE_IDLE;
                        }
                    }
                    break;

                case INPUT_PIN_STATE_WAIT_DOUBLE:
                    if (pressed) {
                        /* Pencere içinde ikinci basış → Double Press */
                        xTimerStop(s->timer_handler, 0);
                        input_publish(s, INPUT_EVENT_TYPE_DOUBLE_PRESS);
                        /* İkinci basışın bırakılmasını bekle, sonra IDLE */
                        while (hal_gpio_read(s->gpio->pin) != s->gpio->default_state);
                        s->pin_state = INPUT_PIN_STATE_IDLE;

                    } else if (s->wait_count_ms >= DOUBLE_PRESS_WINDOW_MS) {
                        /* Pencere doldu, ikinci basış gelmedi → Single Press */
                        xTimerStop(s->timer_handler, 0);
                        input_publish(s, INPUT_EVENT_TYPE_PRESS);
                        s->pin_state = INPUT_PIN_STATE_IDLE;
                    }
                    break;
            }
        }
    }

    free(input->states);
    free(input);
}